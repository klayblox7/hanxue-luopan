    "remotion:render": "remotion render remotion/index.tsx KoreaLinkShortCn9x16 output/korea-link-short-cn-9x16.mp4",
    "remotion:still:wide": "remotion still remotion/index.tsx KoreaLinkFilm16x9 output/korea-link-film-16x9-frame.png --frame=240",
    "remotion:still:vertical": "remotion still remotion/index.tsx KoreaLinkFilm9x16 output/korea-link-film-9x16-frame.png --frame=500",
    "remotion:render:wide": "remotion render remotion/index.tsx KoreaLinkFilm16x9 output/korea-link-film-16x9.mp4",
    "remotion:render:vertical": "remotion render remotion/index.tsx KoreaLinkFilm9x16 output/korea-link-film-9x16.mp4"
