    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "es-abstract": "^1.24.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "impeccable": "^2.1.9",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.49",
    "remotion": "4.0.477",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "zod": "4.3.6"
